# Environment Variables Example
# Copy this file to .env.local and update with your actual values

# Appwrite Configuration
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=your-project-id-here
NEXT_PUBLIC_APPWRITE_DATABASE_ID=your-database-id-here
NEXT_PUBLIC_APPWRITE_USERS_COLLECTION_ID=users
NEXT_PUBLIC_APPWRITE_BOOKINGS_COLLECTION_ID=bookings
NEXT_PUBLIC_APPWRITE_REVIEWS_COLLECTION_ID=reviews
NEXT_PUBLIC_APPWRITE_CONTACTS_COLLECTION_ID=contacts
NEXT_PUBLIC_APPWRITE_STORAGE_BUCKET_ID=your-storage-bucket-id-here

# Server-side Appwrite (used by API routes like /api/payment/verify)
# Create an API key in Appwrite Console with Databases read/write permissions
APPWRITE_PROJECT_ID=your-project-id-here
APPWRITE_DATABASE_ID=your-database-id-here
APPWRITE_API_KEY=your-appwrite-api-key-here

# Base URL used in payment returnUrl/webhook
# For local: http://localhost:3000
# For prod: https://edu-nova.tech (or your domain)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Cashfree Payment Gateway
# Get these from Cashfree Dashboard (Sandbox/Production)
CASHFREE_APP_ID=your-cashfree-app-id
CASHFREE_SECRET_KEY=your-cashfree-secret
# 'sandbox' or 'production' (controls API URL and JS SDK mode)
NEXT_PUBLIC_CASHFREE_MODE=sandbox

# Instructions:
# 1. Go to https://cloud.appwrite.io and create a new project
# 2. Copy your Project ID from the project settings
# 3. Create a new database and copy the Database ID
# 4. Create collections for users, bookings, reviews, and contacts
# 5. Copy your collection IDs
# 6. Create a storage bucket for file uploads and copy the Bucket ID
# 7. Update the values above and rename this file to .env.local

# Additional steps for production:
# - Add your domain (edu-nova.tech and www.edu-nova.tech) to Appwrite > Authentication > Platforms for CORS
# - In Cashfree Dashboard, set Return URL to: https://your-domain.com/payment/callback
# - In Cashfree Dashboard, set Webhook URL to: https://your-domain.com/api/payment/webhook
# - In Vercel, add the same env vars and redeploy
